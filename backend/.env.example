# Local development env for frenqency_circle/admin
# Copy to .env and adjust as needed

# PostgreSQL — points to docker-compose service by default
DATABASE_URL="postgresql://frenqency:frenqency@localhost:5432/frenqency_circle"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-output-of-openssl-rand-base64-32"

# Required for non-HTTPS dev environments
AUTH_TRUST_HOST="true"

# --- Cache (统一缓存层,默认进程内内存缓存) ---
# 不配置任何变量即为内存缓存:单进程生效,无需额外服务。
# 多实例部署需要全局一致时:设 CACHE_DRIVER=redis 并配置 REDIS_URL。
# 未设置 CACHE_DRIVER 时按 REDIS_URL 自动推断(有则 redis,否则 memory);
# CACHE_DRIVER=redis 但缺 REDIS_URL、或 @keyv/redis 加载失败时会告警并自动回退内存。
CACHE_DRIVER=""
REDIS_URL=""
# 缓存 key 统一前缀(多应用 / 多环境共用同一 Redis 时用于隔离,默认 qlq)
CACHE_KEY_PREFIX=""
# 限流 key 中手机号 / IP 的加盐盐值(留空回退 AUTH_SECRET;避免明文 PII 落入 Redis key)
CACHE_KEY_SALT=""

# --- Aliyun SMS (phone login) ---
# Leave ALIYUN_SMS_ACCESS_KEY_ID empty to enable dev console-logging fallback
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""
ALIYUN_SMS_ENDPOINT="dysmsapi.aliyuncs.com"

# Email domain auto-generated for phone-login users
PHONE_DOMAIN="phonedomain.com"

# SMS rate limits (optional overrides)
SMS_CODE_TTL_SECONDS="300"
SMS_CODE_MAX_ATTEMPTS="5"
SMS_RATE_PHONE_COOLDOWN_SECONDS="60"
SMS_RATE_PHONE_HOURLY="5"
SMS_RATE_IP_HOURLY="10"

# --- WeChat Mini-Program (phone login) ---
# From mp.weixin.qq.com → 开发管理 → 开发设置
WECHAT_MP_APP_ID=""
WECHAT_MP_APP_SECRET=""
WECHAT_MP_API_BASE="https://api.weixin.qq.com"

# --- WeChat Official Account (H5 微信浏览器 JSSDK 分享签名) ---
# 网页 JS 接口使用【公众号】的 appId/Secret，与小程序 appId 不同。
# 公众号后台需配置「JS 接口安全域名」为 H5 部署域名（需 HTTPS），
# 且该域名需与下方 WECHAT_OA_JS_DOMAINS / NEXT_PUBLIC_APP_URL 一致。
# From mp.weixin.qq.com → 设置与开发 → 公众号设置 → 功能设置 → JS 接口安全域名
WECHAT_OA_APP_ID=""
WECHAT_OA_APP_SECRET=""
WECHAT_OA_API_BASE="https://api.weixin.qq.com"
# 签名接口允许的域名白名单(逗号分隔,可带协议,如 https://fc.example.com,https://dev.example.com)。
# 留空时回退 NEXT_PUBLIC_APP_URL；两者都为空则不限制域名(仅本地开发建议,生产必须配置)。
WECHAT_OA_JS_DOMAINS=""

# --- Future OAuth providers (optional) ---
# To enable GitHub OAuth:
# 1. Create OAuth App at https://github.com/settings/developers
# 2. Set callback URL to http://localhost:3000/api/auth/callback/github
# 3. Fill these and uncomment:
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# --- 站点公开地址(微信 H5 JSSDK 域名白名单回退等) ---
# 生产部署指向实际域名,如 https://fc.example.com
NEXT_PUBLIC_APP_URL=""

# --- Tencent COS (文件上传唯一通道:客户端直传,后端只签发 STS) ---
# 所有文件上传(头像 / 封面 / 认证材料 / 打卡 / 课程视频等)均走客户端直传 COS,
# 后端不接收文件字节,也没有本地落盘通道。
# 控制台:https://console.cloud.tencent.com/cam/capi → 创建 API 密钥
COS_SECRET_ID=""
COS_SECRET_KEY=""
# Bucket 名(含 APPID 后缀,如 frenqency-1234567890)
COS_BUCKET=""
# 地域(如 ap-shanghai / ap-guangzhou)
COS_REGION=""
# 公开访问基址(可选,无尾斜杠;优先用 CDN 域名)
# 留空 => 自动回退到 bucket 默认外部域名 https://<bucket>.cos.<region>.myqcloud.com
# 例如 https://cdn.example.com 或 https://frenqency-1234567890.cos.ap-shanghai.myqcloud.com
COS_PUBLIC_BASE_URL=""
# 对象 key 前缀(默认 'uploads';空字符串表示无前缀)
# scope 会自动夹到 <keyPrefix>/<userId>/* 实现按用户隔离
COS_KEY_PREFIX="uploads"
# STS 凭证有效期(秒,默认 1800,夹紧到 [60, 7200])
COS_STS_DURATION_SECONDS="1800"

# --- AMap (高德地图 JS API, H5 端地图/定位) ---
# 运行时环境变量:由 admin 通过 GET /api/config/amap.js 注入到 H5 浏览器,
# 不再在 frontend 构建期通过 webpack defineConstants 内联(已废弃)。
# 申请地址:https://lbs.amap.com → 控制台 → 应用管理 → 创建 Web端(JS API) Key
# 生产环境需在高德控制台为该 Key 配置域名白名单(如 fc.shinehe.cn)
# 留空 => H5 地图功能不可用(SDK 加载失败),其它功能不受影响
AMAP_KEY=""
AMAP_SECURITY_CODE=""

# --- 高德 Web 服务 Key(服务端逆地理编码,供微信小程序端) ---
# 用于 GET /api/geo/reverse(经纬度 → 地址)。
# 注意:高德 REST API(v3/geocode/regeo)需要"Web服务"类型的 Key,
# 与上面 H5 用的"Web端(JS API)"Key 不同!若复用 AMAP_KEY(JS API Key)
# 高德会返回 USERKEY_PLAT_NOMATCH。
# 申请地址:https://lbs.amap.com → 控制台 → 应用管理 → 创建 Web服务 Key
# 留空 => 回退使用 AMAP_KEY(仅当 AMAP_KEY 已是 Web服务 Key 时才生效)
AMAP_REST_KEY=""

