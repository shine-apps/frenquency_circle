# 变量必须以 VITE_ 为前缀才能暴露给外部读取（前端 import.meta.env 可见）
# 不带后缀的基础 env：定义所有变量的默认值，各环境文件(.env.development/.env.production/.env.test)再按需覆盖
# 页面路径开头的 / 大部分情况可省略，但作为环境变量配置时不能省略 /

# 应用名称（显示在 H5 标题与小程序 manifest name）
VITE_APP_TITLE = '趣邻圈'
# 服务端口号（H5 dev server）
VITE_APP_PORT = '9000'
# H5 部署基础路径，参考 vite 的 base 配置
VITE_APP_PUBLIC_BASE = '/'

# 后台接口地址（各环境在自己的 env 文件覆盖）
VITE_SERVER_BASEURL = ''
# 备用域名（按需）
VITE_SERVER_BASEURL_SECONDARY = ''
# 微信小程序不同运行环境后台地址，不配置则回退到 VITE_SERVER_BASEURL
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = ''
VITE_SERVER_BASEURL__WEIXIN_TRIAL = ''
VITE_SERVER_BASEURL__WEIXIN_RELEASE = ''

# H5 开发时是否启用代理（mp/app 端不生效）
VITE_APP_PROXY_ENABLE = false
# 代理前缀（H5 开发时拼到请求前，再由 vite proxy 剥离）
VITE_APP_PROXY_PREFIX = '/fg-api'
# 后端接口是否带统一前缀 /api
VITE_SERVER_HAS_API_PREFIX = false

# 认证模式：single=单token；double=双token（后端当前返回单 token，保持 single）
VITE_AUTH_MODE = 'single'

# 是否去除 console 与 debugger（生产建议 true）
VITE_DELETE_CONSOLE = false
# 是否生成 sourcemap（默认 false）
VITE_SHOW_SOURCEMAP = false

# App 端是否复制原生插件资源
VITE_COPY_NATIVE_RES_ENABLE = false

# 微信小程序 appid（游客模式可用 touristappid；真机预览/上传需改为真实 appid）
VITE_WX_APPID = 'wxb4498858afb9d4bc'
