# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# production mode 后台请求地址
# H5 采用同源部署:nginx 将 /api 代理到 app 容器(见 nginx.conf),故前端可留空走同源相对路径
# 小程序端仍需显式配置,否则会回退到下方本地地址
VITE_SERVER_BASEURL = 'https://fc.shinehe.cn'
# 备注:如有独立域名(如 https://api.xxx.com),则改为完整地址
